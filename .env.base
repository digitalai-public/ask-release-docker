# ----------------------------------------------------------------------------
# Ask Release Docker - shared base configuration
#
# This is the checked-in template every deployment starts from. Copy it
# to `.env` (gitignored) and customise per host:
#
#     cp .env.base .env
#     # edit .env to set hostnames, OAuth client credentials, IdP issuer,
#     # and any other per-deployment override
#
# Compose reads `.env` from the project root implicitly, so a bare
# `docker compose -f docker-compose.yaml ...` invocation picks up your
# customised values without any `--env-file` flag.
#
# .env.base sets the values that are the same across every deployment:
#
#   - container image tags (RELEASE_ASSISTANT_IMAGE, ...)
#   - exposed host ports (ASSISTANT_PORT, ...)
#   - public FQDNs and derived public URLs (RELEASE_PUBLIC_URL, ...)
#   - shared auth / tenancy values (OAUTH2_TOKEN_CLIENT_ID, OIDC_ISSUER_URI)
#
# Compose files (release-assistant/compose.yaml, llm-service/compose.yaml,
# test-lab/*/compose.yaml) inline ${VAR:-default} fallbacks for every
# other env var they consume. That keeps per-service defaults next to
# the consumer and lets you override them either in the compose file
# (uncomment the template line) or in your customised .env.
#
# Note: The MCP (Model Context Protocol) server is no longer a separate
# component. It is embedded inside Digital.ai Release and exposed at
# ${RELEASE_BASE_URL}${RELEASE_MCP_SERVER_ENDPOINT:-/s/mcp}. The
# Assistant connects to that endpoint directly; no separate MCP image,
# service, port, or OIDC config is needed.
# ----------------------------------------------------------------------------

# Image tags
# WARNING: xebialabsunsupported images are for internal usage only.
# For production documentation and production deployments, use xebialabs/* images.
RELEASE_ASSISTANT_IMAGE=xebialabsunsupported/dai-release-assistant:0.2.0
LLM_SERVICE_API_IMAGE=docker.usw2mgt.dev.digitalai.cloud/digital-ai/k6i-llm-service/llm-service-api:0.0.1.255
LLM_SERVICE_DBINIT_IMAGE=docker.usw2mgt.dev.digitalai.cloud/digital-ai/k6i-llm-service/llm-service-dbinit:0.0.1.255
RELEASE_IMAGE=xebialabsunsupported/xl-release:26.3.0-beta.708
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6
POSTGRES_IMAGE=postgres:18.4-alpine
NGINX_IMAGE=nginx:1.31-alpine

# Public exposed ports
ASSISTANT_PORT=8090
LLM_SERVICE_PORT=9000
RELEASE_HTTP_PORT=5516
KEYCLOAK_HTTP_PORT=5080
KEYCLOAK_MGMT_PORT=15090
POSTGRES_PORT=5432
NGINX_HTTPS_PORT=5443

# Postgres host used by all DB URL variables.
# Change POSTGRES_HOSTNAME when pointing to an external/customer-managed Postgres.
POSTGRES_HOSTNAME=postgres

# Public FQDNs that will be served over HTTPS. Add each one as a SAN on the
# TLS cert (or use a wildcard). Leave blank to serve only the
# *.example.digital.ai.local aliases baked into the vhost configs.
ASSISTANT_HOSTNAME=release-assistant.example.digital.ai.local
RELEASE_HOSTNAME=release.example.digital.ai.local
IDP_HOSTNAME=identity.example.digital.ai.local

# Public Release URL
RELEASE_PUBLIC_URL=https://${RELEASE_HOSTNAME}:${RELEASE_HTTP_PORT}

# Public Assistant URL
RELEASE_ASSISTANT_PUBLIC_URL=https://${ASSISTANT_HOSTNAME}:${ASSISTANT_PORT}

# ----------------------------------------------------------------------------
# Release connectivity and embedded MCP endpoint
# RELEASE_PUBLIC_URL drives the browser-facing Release URL (CORS, OIDC
# redirect URIs by default).
# RELEASE_INTERNAL_URL is the in-bridge URL the Assistant uses to reach the
# Release API and the embedded MCP server. It defaults to the bridge-local
# alias (http://release:${RELEASE_HTTP_PORT}). Set to the operator's
# customer-managed URL when the Assistant talks to Release over a private
# network that differs from the public URL.
# RELEASE_MCP_SERVER_ENDPOINT is the path the embedded MCP server is mounted
# at on the Release image. Defaults to /s/mcp; override only if your
# Release image exposes the MCP server at a different path.
# ----------------------------------------------------------------------------
RELEASE_INTERNAL_URL=http://release:${RELEASE_HTTP_PORT}
RELEASE_MCP_SERVER_ENDPOINT=/s/mcp


# ----------------------------------------------------------------------------
# Core auth and tenancy
# ----------------------------------------------------------------------------
OAUTH2_TOKEN_CLIENT_ID=replace-me
OAUTH2_TOKEN_CLIENT_SECRET=replace-me
OAUTH2_SCOPES="openid, dai-svc"

# OIDC discovery (k8s-style env vars consumed by the assistant configmap).
# JWKS URI is derived from the issuer in
# release-assistant/compose.yaml (inline `${OIDC_JWK_SET_URI:-...}`
# fallback; Keycloak-style: ${issuer}/protocol/openid-connect/certs).
# Override OIDC_JWK_SET_URI only if your IdP uses a non-standard layout.
OIDC_ISSUER_URI=https://${IDP_HOSTNAME}/auth/realms/company

# ----------------------------------------------------------------------------
# Assistant AI / LLM endpoint configuration
# Consumed by release-assistant/config/release-ai-assistant-config.yaml via
# ${VAR:default} substitution AND by the release-assistant container env
# (inlined as ${VAR:-default} in release-assistant/compose.yaml). Override
# per deployment in your layered .env.
# ----------------------------------------------------------------------------
# AI_MODEL_CHAT=llm
# AI_LLM_BASE_URL=https://api.staging.digital.ai/llm
# AI_LLM_CHAT_MODEL=anthropic.claude-sonnet-4-6
# AI_LLM_CHAT_TEMPERATURE=0.3
# AI_LLM_CHAT_MAX_TOKENS=4096
# To point the Assistant at the local LLM service instead of SaaS, set
# AI_LLM_BASE_URL=http://llm-service-api:9000 in your layered .env.

# ----------------------------------------------------------------------------
# Local LLM service connection (k8s-style DAI_* binding namespace consumed by
# llm-service/compose.yaml). Required when --profile with-llm-service is on
# and the Assistant points AI_LLM_BASE_URL at the local llm-service-api.
# DAI_AUTH_DISCOVERY_URL, DAI_AUTH_TENANT_ID_CLAIM (=tid), and
# DAI_ACCOUNT_API_TOKEN have inline empty defaults in compose.
# DAI_ACCOUNT_ID and DAI_AUTH_ISSUER_PATTERN have NO inline default and
# MUST be set in your layered .env for multi-tenant deployments.
# ----------------------------------------------------------------------------
# DAI_ACCOUNT_ID=
# DAI_AUTH_ISSUER_PATTERN=
# DAI_AUTH_DISCOVERY_URL=
# DAI_AUTH_TENANT_ID_CLAIM=tid
# DAI_ACCOUNT_API_TOKEN=

# ----------------------------------------------------------------------------
# Release Assistant database (k8s-style env vars consumed by the assistant
# configmap; DB_URL_SUFFIX is the postgresql JDBC host/port/db fragment).
# POSTGRES_HOSTNAME and POSTGRES_PORT are shared with the test stack and live
# in .env.base. For a customer-managed Postgres, change POSTGRES_HOSTNAME.
# All RELEASE_ASSISTANT_DB_* vars have inline ${VAR:-default} defaults baked
# into release-assistant/compose.yaml and only need to be overridden here
# when pointing at an externally managed database or changing credentials.
# ----------------------------------------------------------------------------
# RELEASE_ASSISTANT_DB_URL_SUFFIX=postgresql://${POSTGRES_HOSTNAME}:${POSTGRES_PORT}/dai_assistant
# RELEASE_ASSISTANT_DB_USERNAME=dai_assistant
# RELEASE_ASSISTANT_DB_PASSWORD=dai_assistant

# ----------------------------------------------------------------------------
# Local LLM Service database
# Required for default mode (`docker compose --profile with-llm-service up ...`).
# Note: product default for *_DB_ENCRYPTED is true. It is set to false here
# for easier PoC/testing. For production, set LLM_DB_ENCRYPTED=true and
# provide a 16 or 32 byte LLM_DB_ENCRYPTION_KEY.
# All LLM_DB_* vars have inline ${VAR:-default} defaults in
# llm-service/compose.yaml and are not redefined here. Override per
# deployment in your layered .env.
# LLM_DB_HOST / LLM_DB_PORT chain to POSTGRES_HOSTNAME / POSTGRES_PORT when
# not overridden, so changing POSTGRES_HOSTNAME is enough to point the LLM
# service at an external database.
# ----------------------------------------------------------------------------
# LLM_DB_HOST=${POSTGRES_HOSTNAME}
# LLM_DB_PORT=${POSTGRES_PORT}
# LLM_DB_NAME=dai_llm
# LLM_DB_USERNAME=dai_llm
# LLM_DB_PASSWORD=dai_llm
# LLM_DB_ENCRYPTED=false
# LLM_DB_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Local LLM provider configuration
# Required for default mode (`docker compose --profile with-llm-service up ...`).
# LLM_SERVICE_DEFAULT_PROVIDER_CONFIG must be base64 encoded JSON.
# LLM_SERVICE_DEFAULT_SYSTEM_MODEL_ALIAS_MAPPINGS is optional (base64 JSON).
# LLM_SERVICE_DEFAULT_PROVIDER_NAME must start with the `dai-` prefix.
# Both vars have inline ${VAR:-default} defaults in llm-service/compose.yaml.
# ----------------------------------------------------------------------------
# LLM_SERVICE_DEFAULT_PROVIDER_NAME=dai-openai
# LLM_SERVICE_DEFAULT_PROVIDER_CONFIG=
# LLM_SERVICE_DEFAULT_SYSTEM_MODEL_ALIAS_MAPPINGS=

# ----------------------------------------------------------------------------
# LLM service observability / log level (optional)
# All knobs below have inline ${VAR:-default} defaults in
# llm-service/compose.yaml. Override per deployment in your layered .env.
# ----------------------------------------------------------------------------
# LLM_LOG_LEVEL=INFO
# LLM_PLAINTEXT_LOGGING=false
# LLM_DBINIT_LOG_LEVEL=INFO
# LLM_DBINIT_PLAINTEXT_LOGGING=false
# LLM_OTEL_ENABLED=false
# LLM_OTEL_TRACES_EXPORTER=otlp
# LLM_OTEL_METRICS_EXPORTER=otlp
# LLM_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# LLM_OTEL_EXPORTER_OTLP_ENDPOINT=
# LLM_OTEL_SERVICE_NAME=llm-service
# LLM_JOB_SERVICES_INTEGRATION_ENABLED=false
# LLM_USAGE_TRACKING_ENABLED=false

# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# Optional corporate proxy settings (consumed by every CORE and TEST service).
# HTTP_PROXY / HTTPS_PROXY have inline empty defaults in compose; uncomment
# here or set in your layered .env to enable.
# NO_PROXY is consumed by every container (inline empty default in compose);
# override here to exclude in-bridge hostnames from proxying.
# ----------------------------------------------------------------------------
# HTTP_PROXY=http://proxy.corp.example.com:8080
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# NO_PROXY=localhost,127.0.0.1,release,release-assistant,llm-service-api,postgres,keycloak,nginx

# ----------------------------------------------------------------------------
# CORE service log retention (docker json-file driver, see §25 in README).
# Default: 5 files x 10 MB per service. Tune up for compliance retention,
# tune down to reduce disk pressure.
# ----------------------------------------------------------------------------
ASSISTANT_LOG_MAX_SIZE=10m
ASSISTANT_LOG_MAX_FILE=5

# ----------------------------------------------------------------------------
# Optional local Keycloak IdP (with --profile with-keycloak)
# When with-keycloak is active, OIDC_* values default to the local Keycloak
# realm so Assistant / LLM / Release validate against the in-stack IdP
# instead of an external one.
# KEYCLOAK_IMAGE, KEYCLOAK_HTTP_PORT, KEYCLOAK_MGMT_PORT live in .env.base.
# KEYCLOAK_ADMIN_USER / _PASSWORD have inline defaults in compose.
# The local realm ships in test-lab/keycloak/data/xl-platform-realm.json.
# ----------------------------------------------------------------------------
# KEYCLOAK_REALM=xl-platform
# KEYCLOAK_LOCAL_ISSUER=http://${IDP_HOSTNAME}:${KEYCLOAK_HTTP_PORT}/realms/${KEYCLOAK_REALM}
# When with-keycloak is active, override these in your layered .env:
# OIDC_ISSUER_URI=${KEYCLOAK_LOCAL_ISSUER}
# DAI_AUTH_ISSUER_PATTERN=${KEYCLOAK_LOCAL_ISSUER}
# AI_LLM_BASE_URL=http://llm-service-api:9000
